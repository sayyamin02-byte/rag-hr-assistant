# Copy this file to ".env" and fill in ONE provider. Retrieval works without any of this;
# these are only for the final written answer (Step 3 / generate.py).

# --- Option A: Groq (free, fast) — recommended ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_key_here
LLM_MODEL=llama-3.1-8b-instant

# --- Option B: Ollama (fully local, no key) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# --- Option C: OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
